COMPOSE_FILE=compose.yaml

GH_PAGER=""

RUST_BACKTRACE=1
RUST_LOG=warn,nisshi_broker=debug,nisshi_storage=debug,nisshi_schema=debug

NISSHI_IMAGE=ghcr.io/nisshi-io/solace-nisshi:latest

# Kafka cluster:
CLUSTER_ID="nisshi-spark"

PULL_POLICY=missing

ADVERTISED_LISTENER_URL="tcp://nisshi:9092"

AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
AWS_DEFAULT_REGION="eu-west-2"
AWS_ENDPOINT="http://minio:9000"
AWS_ALLOW_HTTP="true"

STORAGE_ENGINE="s3://nisshi"
DATA_LAKE="s3://lake"

SCHEMA_REGISTRY="file://schema"

ICEBERG_CATALOG="http://iceberg-catalog:8181"
